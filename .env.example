# --------------------------------------------------
# PS-4.1 Agent Behavioral Baseline Builder
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# --------------------------------------------------

# Google Gemini API key (free tier — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# AWS region for DynamoDB / Lambda
AWS_REGION=us-east-1

# DynamoDB table names (must match template.yaml)
BASELINES_TABLE=AgentBaselines
SESSIONS_TABLE=SessionScores
