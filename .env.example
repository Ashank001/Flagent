# ==============================================================================
# Flagent — Configuration & Environment Variables
# Copy this file to .env and configure for your target environment.
# NEVER commit your real .env file or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Storage Backend Selection
# Options: "memory", "firestore", "dynamodb"
# Default: "memory"
# ------------------------------------------------------------------------------
STORAGE=memory

# ------------------------------------------------------------------------------
# Server & Network Settings (FastAPI / Docker / Render)
# ------------------------------------------------------------------------------
PORT=8000
ALLOWED_ORIGINS=*
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Google Gemini API
# Required only for running synthetic baseline scenario generation.
# Free tier key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# Google Cloud / Firebase Firestore Settings (when STORAGE=firestore)
# Provide authentication via either file path OR raw JSON string.
# ------------------------------------------------------------------------------
# Option A: Path to service account JSON key file (local development / Docker mount)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Option B: Raw JSON string of service account (ideal for Render / PaaS env vars)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional overrides:
# FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_ROOT_COLLECTION=agents
FIRESTORE_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# AWS DynamoDB Settings (legacy backend when STORAGE=dynamodb / AWS Lambda)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
BASELINES_TABLE=AgentBaselines
SESSIONS_TABLE=SessionScores
AGENT_REGISTRY_TABLE=AgentRegistry
